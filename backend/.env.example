# Backend Environment Variables
# Copy this file to .env and fill in your actual keys

# Clerk Backend
# Get from: https://dashboard.clerk.com -> API Keys -> Secret Key
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Google Gemini API
# Get from: https://ai.google.dev -> Get API Key
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase
# Get from: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (if using PostgreSQL directly)
# DATABASE_URL=postgresql://user:password@localhost:5432/receipt_flow
